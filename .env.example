# V-Intern Frontend — environment template
# Copy thành `.env` và điền giá trị thật (KHÔNG commit file .env).

# Base URL của backend V-Intern (tùy chọn).
# Chưa có contract → để trống; form newsletter sẽ hiển thị trạng thái
# "chưa kết nối". Khi backend ra mắt, điền ví dụ:
# NEXT_PUBLIC_API_BASE_URL=https://api.v-intern.example
NEXT_PUBLIC_API_BASE_URL=
